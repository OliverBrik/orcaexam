# Ignore everything
/*

# But do not ignore the .gitignore file itself
!.gitignore
!.github/
!.github/*.*

# Do not ignore wp-content and everything inside it
!wp-content/
!wp-content/themes/**/*

wp-content/themes/twenty*/**
wp-content/themes/index.php
wp-content/plugins/index.php

# Generated WP-Optimize cache and machine-specific loader.
/wp-content/advanced-cache.php
/wp-content/cache/
/wp-content/wpo-cache/

# Runtime data: regenerated by plugins and specific to each installation.
/wp-content/wflogs/
/wp-content/uploads/burst/
/wp-content/uploads/burst-sessions/
/wp-content/uploads/wc-logs/
/wp-content/uploads/wpo/
/wp-content/updraft/log.*.txt
/wp-content/updraft/backup_*
/wp-content/upgrade/
/wp-content/upgrade-temp-backup/
